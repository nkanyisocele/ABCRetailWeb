@model ABCRetailWeb.Models.DashboardViewModel

@{
    ViewData["Title"] = "ABC Retail Enterprise Dashboard";
}

<div class="container-fluid mt-4 px-4">
    <h1 class="text-center mb-5 border-bottom pb-3 text-primary">ABC Retail Integrated Cloud Management</h1>

    <div class="row">
        <!-- LEFT PANELS: TABLES DATA -->
        <div class="col-lg-8">
            <div class="row">
                <!-- CUSTOMER SECTION -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm p-3">
                        <h4 class="text-secondary mb-3">Add Customer Profile</h4>
                        <form asp-action="AddCustomer" method="post">
                            <div class="mb-2"><input name="FirstName" class="form-control form-control-sm" placeholder="First Name" required /></div>
                            <div class="mb-2"><input name="LastName" class="form-control form-control-sm" placeholder="Last Name" required /></div>
                            <div class="mb-2"><input name="Email" type="email" class="form-control form-control-sm" placeholder="Email Address" required /></div>
                            <div class="mb-2"><input name="PhoneNumber" class="form-control form-control-sm" placeholder="Phone Number" /></div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">Save Customer Data</button>
                        </form>
                    </div>

                    <h5 class="mt-3">Customer Database Records</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-sm align-middle">
                            <thead class="table-dark"><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    @foreach (var customer in Model.Customers)
                                    {
                                        <tr><td>@customer.FirstName @customer.LastName</td><td>@customer.Email</td><td>@customer.PhoneName</td></tr>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No database entries found.</p>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PRODUCT DATA SECTION -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm p-3">
                        <h4 class="text-secondary mb-3">Add Product Details</h4>
                        <form asp-action="AddProduct" method="post">
                            <div class="mb-2"><input name="ProductName" class="form-control form-control-sm" placeholder="Product Name" required /></div>
                            <div class="mb-2"><input name="Description" class="form-control form-control-sm" placeholder="Product Description" /></div>
                            <div class="mb-2"><input name="Price" type="number" step="0.01" class="form-control form-control-sm" placeholder="Price" required /></div>
                            <button type="submit" class="btn btn-success btn-sm w-100">Save Product Data</button>
                        </form>
                    </div>

                    <h5 class="mt-3">Product Catalog Inventory</h5>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-sm align-middle">
                            <thead class="table-dark"><tr><th>Item Name</th><th>Description</th><th>Base Price</th></tr></thead>
                            <tbody>
                                @if (Model?.Products != null)
                            {
                                @foreach (var product in Model.Products)
                                {
                                    <tr><td>@product.ProductName</td><td>@product.Description</td><td>@product.Price.ToString("C")</td></tr>
                                }
                            }
                                else
                                {
                                    <p class="text-muted">No database entries found.</p>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: BLOB MULTIMEDIA MANAGEMENT -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm p-3 bg-light mb-4">
                <h4 class="text-dark mb-3">Upload Product Image (Blobs)</h4>

                <!-- enctype="multipart/form-data" is mandatory for processing system files -->
                <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Choose an image file (.jpg, .png, .webp)</label>
                        <input type="file" name="file" class="form-control form-control-sm" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm w-100">Upload to Azure Cloud Blob</button>
                </form>
            </div>

            <h5 class="mb-3">Live Blob Storage Gallery</h5>
            <div class="row g-2">
                @if (Model?.ImageUrls == null || !Model.ImageUrls.Any())
                {
                    <div class="col-12"><p class="text-muted small text-center bg-white py-3 border rounded">No images stored yet.</p></div>
                }
                else
                {
                    @foreach (var url in Model.ImageUrls)
                    {
                        <div class="col-6 col-sm-4 col-lg-6">
                            <div class="card h-100 shadow-sm overflow-hidden">
                                <img src="@url" class="card-img-top img-fluid" style="height: 120px; object-fit: cover;" alt="Azure Blob" />
                                <div class="card-footer p-1 text-center bg-white">
                                    <a href="@url" target="_blank" class="text-truncate d-block small text-decoration-none text-muted" style="font-size: 0.75rem;">Open Full URL</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

